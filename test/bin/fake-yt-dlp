#!/bin/sh
# Fake yt-dlp for the yt tests.
#
# FAKE_SCENARIO=DIR describes one step per call.  For the Nth call
# (NN = 01, 02, ...) it records its arguments, one per line, in DIR/argv-NN,
# then:
#   - copies DIR/NN.cookies over the file given with --cookies, if both exist,
#     as yt-dlp does when it saves rotated cookies;
#   - prints DIR/NN.err to standard error and DIR/NN.out to standard output,
#     one line every 50 ms if DIR/NN.mode is "stream" or "stream-hang";
#   - sleeps until killed if DIR/NN.mode is "hang" or "stream-hang";
#   - exits with the status in DIR/NN.exit, default 0.
# If DIR/expired-sid exists and the --cookies file contains its text,
# the call instead prints DIR/expired.err and exits 1, whatever its
# number: a session that expired, however the calls interleave.
#
# Copyright (C) 2026 Erik Sundin
# SPDX-License-Identifier: GPL-3.0-or-later

set -u
dir=${FAKE_SCENARIO:?FAKE_SCENARIO is not set}

# Number the calls; the lock keeps concurrent calls from sharing a number.
while ! mkdir "$dir/lock" 2>/dev/null; do sleep 0.01; done
n=$(( $(cat "$dir/count" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$dir/count"
rmdir "$dir/lock"
nn=$(printf '%02d' "$n")

: > "$dir/argv-$nn"
cookies= prev=
for arg in "$@"; do
    printf '%s\n' "$arg" >> "$dir/argv-$nn"
    [ "$prev" = "--cookies" ] && cookies=$arg
    prev=$arg
done

if [ -n "$cookies" ] && [ -f "$dir/expired-sid" ] \
       && grep -qF "$(cat "$dir/expired-sid")" "$cookies"; then
    cat "$dir/expired.err" >&2
    exit 1
fi

mode=$(cat "$dir/$nn.mode" 2>/dev/null || echo plain)
if [ -n "$cookies" ] && [ -f "$dir/$nn.cookies" ]; then
    cat "$dir/$nn.cookies" > "$cookies"
fi
if [ -f "$dir/$nn.err" ]; then
    cat "$dir/$nn.err" >&2
fi
if [ -f "$dir/$nn.out" ]; then
    case $mode in
        stream|stream-hang)
            while IFS= read -r line; do
                printf '%s\n' "$line"
                sleep 0.05
            done < "$dir/$nn.out" ;;
        *) cat "$dir/$nn.out" ;;
    esac
fi
case $mode in
    hang|stream-hang) exec sleep 1000 ;;
esac
exit "$(cat "$dir/$nn.exit" 2>/dev/null || echo 0)"
